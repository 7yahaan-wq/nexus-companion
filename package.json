{
  "name": "nexus-companion",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first desktop AI development companion",
  "author": "Nexus Companion",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build-domain.cjs && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "verify": "node scripts/verify.cjs",
    "doctor": "node scripts/doctor.cjs",
    "smoke": "electron . --smoke",
    "package": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "39.8.10",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.nexus.companion",
    "productName": "Nexus Companion",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NexusCompanion-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NexusCompanion-Portable-${version}.${ext}"
    }
  }
}
